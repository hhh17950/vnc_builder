# 复制为 vnc-worker.env 后填写；安装时会复制到 /etc/vnc-worker.env。
VNC_API_URL=http://api.example.internal:8088
VNC_REDIS_URL=redis://redis.example.internal:6379/0
VNC_REDIS_PREFIX=vnc_schedule
# 当前物理机的固定管理网 IP，由部署人员填写。
VNC_WORKER_ID=192.168.10.21
VNC_SLOT_COUNT=8
VNC_MANAGER_SCRIPT=/opt/vnc_manager/vnc_manager.sh
VNC_SHARED_ROOT=/mnt/shared-tests
VNC_LOG_DIR=/var/log/vnc-worker
VNC_HEARTBEAT_SECONDS=5
VNC_STOP_GRACE_SECONDS=5
VNC_CLEANUP_SECONDS=10
VNC_MANAGER_TIMEOUT_SECONDS=15
